generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  password  String
  username  String   @unique
  profile   Profile?
  createdAt DateTime @default(now())

  articles Article[]
  comments Comment[]
  images   Image[]
}

model Profile {
  id       Int     @id
  user     User    @relation(fields: [id], references: [id])
  first    String?
  last     String?
  age      Int?
  currency String?
  country  String?
  city     String?

  avatar Image?
}

model Article {
  id        Int       @id @default(autoincrement())
  title     String
  subtitle  String
  images    Image[]
  views     Int       @default(0)
  createdAt DateTime  @default(now())
  type      String[]
  blocks    Json
  comments  Comment[]
  authorId  Int

  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

enum ImageType {
  AVATAR  @map("avatar")
  ARTICLE @map("article")
}

model Image {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  type      ImageType
  mimeType  String
  base64    String

  userId Int
  user   User @relation(fields: [userId], references: [id])

  profileId Int?     @unique
  profile   Profile? @relation(fields: [profileId], references: [id])

  articleId Int?
  article   Article? @relation(fields: [articleId], references: [id])

  @@index([userId])
  @@index([articleId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  text      String

  userId Int
  user   User @relation(fields: [userId], references: [id])

  articleId Int
  article   Article @relation(fields: [articleId], references: [id])

  @@index([articleId])
  @@index([userId])
}
